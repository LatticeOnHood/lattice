# ---------------------------------------------------------------- Lattice API
# Base URL of the backend in backend/ (routes: /auth, /api/audit).
NEXT_PUBLIC_API_URL=https://api.latticehood.app

# Canonical site URL — used for metadata and the WalletConnect app record.
NEXT_PUBLIC_SITE_URL=https://latticehood.app

# ------------------------------------------------------------- Wallet connect
# Required for WalletConnect-backed wallets, Robinhood Wallet included.
# Free project id from https://cloud.reown.com. Without it the connect modal
# falls back to browser-injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------ Robinhood Chain
# "mainnet" (chain id 4663) or "testnet" (46630). Defaults to mainnet.
NEXT_PUBLIC_ROBINHOOD_NETWORK=mainnet
# Optional. Overrides the public Robinhood RPC, which is rate limited and not
# recommended for production (e.g. an Alchemy Robinhood Chain endpoint).
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# ---------------------------------------------------------------- Telegram
# Bot username (no @) backing the Telegram Login Widget. Must be the same bot
# whose token the backend verifies the widget HMAC with.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

NEXT_PUBLIC_GMGN_API_KEY=
