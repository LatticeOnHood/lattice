{
  "name": "lattice-backend",
  "version": "1.0.0",
  "description": "Lattice token audit & verification backend API powered by GMGN",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "esbuild src/serverless.ts --bundle --platform=node --target=node18 --format=cjs --packages=external --outfile=api/index.js",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@codex-data/sdk": "^2.3.36",
    "@virtuals-protocol/acp-node-v2": "^0.1.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "viem": "^2.55.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "bun-types": "^1.1.42",
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
