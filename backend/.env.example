NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lattice
GMGN_API_KEY=
TWITTER_API_KEY=
TELEGRAM_BOT_TOKEN=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=https://api.latticehood.app/auth/x/callback
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_BOT_ENABLED=true

GROQ_API_KEY=
CODEX_IO_API_KEY=

# ------------------------------------------------- Virtuals ACP (provider)
# Agent wallet ids from the EconomyOS agent page. Identifiers, not keys.
ACP_EVM_WALLET_ID=
ACP_SOLANA_WALLET_ID=

# Generated under Agent Health > Signers. THIS IS A PRIVATE KEY.
# Set it in the Render environment only — never commit a real value here.
ACP_SIGNER_PRIVATE_KEY=

# The agent's own EVM wallet address, shown on the agent page.
ACP_AGENT_WALLET_ADDRESS=

# Base builder code (bc-...) from the agent's Settings tab, if available.
ACP_BUILDER_CODE=

# Robinhood Chain MAINNET. This is the chain the agent is registered on
# (api.acp.virtuals.io) and the chain the reports are about. Do not set this to
# 46630 — that is Robinhood testnet, served by api-dev.acp.virtuals.io, where
# the agent does not exist and every job would fail to route.
# Other supported ids: 8453 Base, 84532 Base Sepolia, 97 BSC testnet.
ACP_CHAIN_ID=4663

# Master switch. With this unset the provider never starts and nothing
# else in the backend is affected.
ACP_ENABLED=false
